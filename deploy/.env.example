# Copy to deploy/.env on the VPS and fill in the blanks.
# deploy/.env is gitignored — it holds real secrets, never commit it.

# Random 32+ chars. Signs the owner_session cookie.  openssl rand -hex 32
NEXTAUTH_SECRET=
# Random 32 chars. Cal.com's at-rest encryption key.  openssl rand -hex 16
CALENDSO_ENCRYPTION_KEY=
OWNER_EMAIL=
OWNER_NAME=
OWNER_USERNAME=

# Cloudflare Access application protecting /owner-login.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=
ACCESS_ALLOWED_EMAILS=you@example.com

# Public URLs — must match the Dockerfile build args (these are baked into the
# client bundle at build time; the runtime copies keep the server side in sync).
NEXT_PUBLIC_WEBAPP_URL=https://booking.example.com
NEXT_PUBLIC_WEBSITE_URL=https://booking.example.com
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site

# Override this for a fork's GHCR package.
BOOKING_IMAGE=ghcr.io/modestapproach/convexbooking:latest

# No Postgres here — the data layer is Convex.
SKIP_DB_MIGRATIONS=1
